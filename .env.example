# App Configuration
APP_ENCRYPTION_KEY="generate-a-32-byte-key-here"
WEBHOOK_SIGNING_SECRET=""
DEFAULT_DAILY_SEND_LIMIT=500
DEFAULT_PER_DOMAIN_LIMIT=50
DEFAULT_TIMEZONE="UTC"
