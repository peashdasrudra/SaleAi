# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/leadpilot?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/leadpilot?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth
AUTH_SECRET="generate-a-strong-secret-here"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI Provider Configuration
AI_PROVIDER="openai" # openai, anthropic, etc.
AI_API_KEY=""
AI_MODEL="gpt-4o"
AI_BASE_URL="" # Optional, for custom providers

# Email Configuration
EMAIL_PROVIDER="resend" # resend, smtp, etc.
EMAIL_API_KEY=""
EMAIL_FROM="noreply@example.com"
EMAIL_REPLY_TO="hello@example.com"
EMAIL_WEBHOOK_SECRET=""

# Notifications
NOTIFICATION_EMAIL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
